# URL du home-runner (via Cloudflare Tunnel si Render, sinon http://127.0.0.1:8080)
HOME_SERVER_URL=http://127.0.0.1:8080

# Clé secrète partagée avec le home-runner (même valeur)
SECRET_KEY=change_me_generate_a_strong_key

# URL publique de CE gateway, utilisée par le client Noctalia (Cloudflare
# Tunnel, Tailscale, Render…). Exemple : https://assistant.tondomaine.fr
GATEWAY_PUBLIC_URL=

# Limite les appels /api/* par IP et par minute (0 = désactivé).
# Important si le gateway est exposé sur Internet.
DESKTOP_RATE_LIMIT_PER_MINUTE=60

# 1 derrière Cloudflare Tunnel / reverse proxy de confiance, sinon 0.
TRUST_PROXY_HEADERS=0

# Longueur maximale d'une réponse avant troncature (0 = pas de limite)
MAX_RESPONSE_LENGTH=50000

# Bot Telegram (obtenable via @BotFather sur Telegram)
TELEGRAM_TOKEN=123456:ABC-DEF...
# URL publique de ce service Render (pour le webhook)
TELEGRAM_WEBHOOK_URL=https://mon-assistant.onrender.com
# Secret du webhook Telegram (laisser vide pour le dériver de SECRET_KEY)
TELEGRAM_WEBHOOK_SECRET=

# Bot Discord (depuis discord.com/developers)
DISCORD_TOKEN=MTI...
DISCORD_GUILD_ID=  # Optionnel: ID de ton serveur Discord (pour les slash commands en dev)

# Sécurité: liste d'IDs utilisateurs autorisés.
# Par défaut (fail-closed), une liste vide refuse tout le monde.
TELEGRAM_ALLOWED_USER_IDS=  # ex: 123456789,987654321
DISCORD_ALLOWED_USER_IDS=   # ex: 123456789,987654321
# Mettre 1 pour autoriser tout le monde SANS whitelist (non recommandé).
ALLOW_ALL_USERS=0

# ── Briefing matinal ─────────────────────────────────────────────────────────
BRIEFING_ENABLED=1
BRIEFING_TIME=08:00
BRIEFING_DAYS=mon,tue,wed,thu,fri,sat,sun
BRIEFING_TIMEZONE=Europe/Paris
BRIEFING_CITY=
BRIEFING_SECTIONS=agenda,news,email,weather,tasks
BRIEFING_WINDOW_MINUTES=5
# Réutilisation du briefing généré (minutes). 0 désactive le cache.
BRIEFING_CACHE_TTL_MINUTES=120

# ── Messages vocaux (Speech-to-Text) ─────────────────────────────────────────
# Optionnel : Groq Whisper (ultra-rapide), sinon OpenAI Whisper, sinon local.
GROQ_API_KEY=
OPENAI_API_KEY=
# Modèle local faster-whisper utilisé si aucune clé API (base, small, medium...)
WHISPER_MODEL=base
# Langue forcée ("fr", "en"...) ou "auto" pour détection automatique
WHISPER_LANGUAGE=auto
# Taille maximale d'un fichier audio accepté (Mo)
STT_MAX_AUDIO_MB=25
