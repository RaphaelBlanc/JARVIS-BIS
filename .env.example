# ==============================================================================
# Configuration globale de l'Assistant Personnel (.env)
# ==============================================================================

# ── 1. Sécurité inter-composants ──────────────────────────────────────────────
# Clé secrète partagée entre render-gateway et home-runner
# Générer avec : python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_generate_a_strong_key

# ── 2. Configuration Réseau ───────────────────────────────────────────────────
# Mode "Serveur Autonome (Tout-en-un)" : http://127.0.0.1:8080
# Mode "Hybride Render + Cloudflare"  : https://votre-tunnel.trycloudflare.com
HOME_SERVER_URL=http://127.0.0.1:8080

# Port d'écoute du runner FastAPI
RUNNER_PORT=8080

# Port d'écoute du gateway FastAPI
GATEWAY_PORT=8000

# URL publique du gateway, si tu l'exposes (Cloudflare Tunnel, Tailscale, Render).
# Sert uniquement d'information dans /api/status et la documentation.
# Exemple : https://assistant.tondomaine.fr
GATEWAY_PUBLIC_URL=

# Limite les appels à /api/* par adresse IP et par minute (0 = désactivé).
# À conserver lorsque le gateway est accessible depuis Internet.
DESKTOP_RATE_LIMIT_PER_MINUTE=60

# 1 uniquement derrière Cloudflare Tunnel ou un reverse proxy de confiance :
# lit CF-Connecting-IP / X-Forwarded-For pour identifier le vrai client.
TRUST_PROXY_HEADERS=0

# Longueur maximale d'une réponse avant troncature (0 = pas de limite)
MAX_RESPONSE_LENGTH=50000

# ── 3. Bots de Messagerie ─────────────────────────────────────────────────────
# Bot Telegram (via @BotFather)
TELEGRAM_TOKEN=123456789:ABCDEF...
# Laisser vide pour activer le mode Polling (recommandé en auto-hébergement)
TELEGRAM_WEBHOOK_URL=
# Secret du webhook Telegram. Laisser vide pour le dériver automatiquement de SECRET_KEY.
TELEGRAM_WEBHOOK_SECRET=

# Bot Discord (via discord.com/developers)
DISCORD_TOKEN=MTE...
# ID optionnel de votre serveur Discord pour synchronisation immédiate des commandes slash en dev
DISCORD_GUILD_ID=

# ── 4. Filtrage & Sécurité d'accès ────────────────────────────────────────────
# Liste des IDs utilisateurs autorisés (séparés par une virgule).
# Par défaut (fail-closed), une liste vide refuse tout le monde.
TELEGRAM_ALLOWED_USER_IDS=
DISCORD_ALLOWED_USER_IDS=
# Mettre 1 pour autoriser tout le monde SANS whitelist (non recommandé).
ALLOW_ALL_USERS=0

# ── 5. Moteur Antigravity CLI ─────────────────────────────────────────────────
# Timeout par défaut en secondes pour les requêtes AGY
AGY_TIMEOUT=120

# Worker agy persistant (stream-json) : 1 = activé, 0 = ancien mode one-shot
AGY_PERSISTENT=1

# Durée d'inactivité avant arrêt automatique du worker (secondes)
AGY_WORKER_IDLE_TIMEOUT=900

# Délai maximal pour le démarrage du worker (secondes)
AGY_STARTUP_TIMEOUT=30

# Sandbox terminal d'agy (1 = activé, 0 = désactivé)
AGY_SANDBOX=1

# Limites d'entrée
MAX_PROMPT_CHARS=20000
MAX_IMAGE_MB=10

# ── 6. Briefing matinal ──────────────────────────────────────────────────────
BRIEFING_ENABLED=1
BRIEFING_TIME=08:00
BRIEFING_DAYS=mon,tue,wed,thu,fri,sat,sun
BRIEFING_TIMEZONE=Europe/Paris
BRIEFING_CITY=
BRIEFING_SECTIONS=agenda,news,email,weather,tasks
BRIEFING_WINDOW_MINUTES=5

# ── 7. Messages vocaux (Speech-to-Text) ──────────────────────────────────────
# Optionnel : Groq Whisper (ultra-rapide), sinon OpenAI Whisper, sinon local.
GROQ_API_KEY=
OPENAI_API_KEY=
# Modèle local faster-whisper utilisé si aucune clé API (base, small, medium...)
WHISPER_MODEL=base
# Langue forcée ("fr", "en"...) ou "auto" pour détection automatique
WHISPER_LANGUAGE=auto
# Taille maximale d'un fichier audio accepté (Mo)
STT_MAX_AUDIO_MB=25
