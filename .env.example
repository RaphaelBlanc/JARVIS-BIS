# ==============================================================================
# Configuration globale de l'Assistant Personnel Unifié (.env)
# ==============================================================================

# ── 1. Mode de Déploiement ────────────────────────────────────────────────────
# - local    : Tout tourne sur ce PC (accès matériel Wayland direct, bots, API).
# - server   : Tourne 24/7 sur serveur distant (le matériel passe par le pc-agent).
# - pc-agent : Tourne sur votre PC local pour relier son matériel à un serveur distant.
DEPLOY_MODE=local

# ── 2. Sécurité inter-composants ──────────────────────────────────────────────
# Clé secrète partagée entre gateway, runner, client Noctalia et pc-agent
# Générer avec : python3 -c "import secrets; print(secrets.token_hex(24))"
SECRET_KEY=change_me_generate_a_strong_key

# ── 3. Configuration Réseau ───────────────────────────────────────────────────
# URL interne du runner (home-runner)
HOME_SERVER_URL=http://127.0.0.1:8080

# Ports d'écoute
RUNNER_PORT=8080
GATEWAY_PORT=8000
PORT=8000

# URL publique HTTPS (Cloudflare Tunnel, Tailscale ou nom de domaine)
GATEWAY_PUBLIC_URL=

# Limite de débit /api/* par IP et par minute (0 = désactivé)
DESKTOP_RATE_LIMIT_PER_MINUTE=60
TRUST_PROXY_HEADERS=0

# ── 4. Bots de Messagerie ─────────────────────────────────────────────────────
# Bot Telegram (via @BotFather)
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# Bot Discord (via discord.com/developers)
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# Whitelist utilisateurs (fail-closed par défaut, séparer par virgules)
TELEGRAM_ALLOWED_USER_IDS=
DISCORD_ALLOWED_USER_IDS=
ALLOW_ALL_USERS=0

# ── 5. Moteur Antigravity CLI (agy) ───────────────────────────────────────────
AGY_TIMEOUT=120
AGY_PERSISTENT=1
AGY_WORKER_IDLE_TIMEOUT=900
AGY_STARTUP_TIMEOUT=30
AGY_SANDBOX=1
MAX_PROMPT_CHARS=20000
MAX_IMAGE_MB=10

# ── 6. Briefing & Rappels ─────────────────────────────────────────────────────
BRIEFING_ENABLED=1
BRIEFING_TIME=08:00
BRIEFING_DAYS=mon,tue,wed,thu,fri,sat,sun
BRIEFING_TIMEZONE=Europe/Paris
BRIEFING_CITY=Paris

# ── 7. Messages Vocaux (STT) ──────────────────────────────────────────────────
GROQ_API_KEY=
OPENAI_API_KEY=
WHISPER_MODEL=base
WHISPER_LANGUAGE=auto

# ── 8. Modules & Outils (Style Plugins / MCP) ─────────────────────────────────

# 💻 Contrôle PC Linux (Wayland, grim, cam, lock, clipboard, son, git scan)
ENABLE_TOOL_SYSTEM_PC=1
WEBCAM_DEVICE=/dev/video0

# 🎓 Moodle EPITA (Devoirs, TPs et échéances)
ENABLE_TOOL_MOODLE=1
MOODLE_URL=https://moodle.epita.fr
MOODLE_API_KEY=

# 💰 Finances & Budget Mensuel (Dépenses, OCR tickets, Apple Pay)
ENABLE_TOOL_EXPENSES=1
MONTHLY_BUDGET=500
JARVIS_WEBHOOK_SECRET=jarvis_apple_pay_secret
GEMINI_API_KEY=

# 🛒 Liste de Courses Interactive
ENABLE_TOOL_SHOPPING=1

# 🧠 Second Cerveau Obsidian
ENABLE_TOOL_OBSIDIAN=1
OBSIDIAN_VAULT_PATH=~/Documents/Obsidian/showcase-vault

# 🎯 Mode Focus & Pomodoro Deep Work
ENABLE_TOOL_FOCUS=1

# 💡 Incubateur d'Idées & Projets
ENABLE_TOOL_IDEAS=1

# 📁 Cockpit Projets & Dev Agent
ENABLE_TOOL_PROJECTS=1

# 🌐 Boîte de Réception Universelle & Radar Tech
ENABLE_TOOL_INBOX=1

# 🗺️ Conseiller Trajets & Départs
ENABLE_TOOL_TRAVEL=1

# 🔒 Sécurité par Code PIN (pavé 4x3)
ENABLE_TOOL_SECURITY_PIN=1

# ⏰ Routines & Tâches Récurrentes en Langage Naturel
ENABLE_TOOL_CRON=1

# 📧 Tri Intelligent des E-mails
ENABLE_TOOL_MAIL_SORTER=1

# 📅 Google Agenda & Google Tasks
ENABLE_TOOL_GOOGLE_WORKSPACE=1

# 🌤️ Météo Locale
ENABLE_TOOL_WEATHER=1
WEATHER_LOCATION=Paris
