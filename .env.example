# ==============================================================================
# Configuration globale de l'Assistant Personnel (.env)
# ==============================================================================

# ── 1. Sécurité inter-composants ──────────────────────────────────────────────
# Clé secrète partagée entre render-gateway et home-runner
# Générer avec : python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_generate_a_strong_key

# ── 2. Configuration Réseau ───────────────────────────────────────────────────
# Mode "Serveur Autonome (Tout-en-un)" : http://127.0.0.1:8080
# Mode "Hybride Render + Cloudflare"  : https://votre-tunnel.trycloudflare.com
HOME_SERVER_URL=http://127.0.0.1:8080

# Port d'écoute du runner FastAPI
RUNNER_PORT=8080

# Port d'écoute du gateway FastAPI
GATEWAY_PORT=8000

# ── 3. Bots de Messagerie ─────────────────────────────────────────────────────
# Bot Telegram (via @BotFather)
TELEGRAM_TOKEN=123456789:ABCDEF...
# Laisser vide pour activer le mode Polling (recommandé en auto-hébergement)
TELEGRAM_WEBHOOK_URL=

# Bot Discord (via discord.com/developers)
DISCORD_TOKEN=MTE...
# ID optionnel de votre serveur Discord pour synchronisation immédiate des commandes slash en dev
DISCORD_GUILD_ID=

# ── 4. Filtrage & Sécurité d'accès ────────────────────────────────────────────
# Liste des IDs utilisateurs autorisés (séparés par une virgule). Laisser vide pour autoriser tout le monde.
TELEGRAM_ALLOWED_USER_IDS=
DISCORD_ALLOWED_USER_IDS=

# ── 5. Moteur Antigravity CLI ─────────────────────────────────────────────────
# Timeout par défaut en secondes pour les requêtes AGY
AGY_TIMEOUT=120
