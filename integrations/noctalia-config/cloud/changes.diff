+import QtQuick
+import QtQuick.Controls
+import Quickshell
+
+FloatingWindow {
+    id: fen
+    signal fermer()
+    title: "Cloud JARVIS"
+    implicitWidth: 680; implicitHeight: 720
+    minimumSize: Qt.size(480, 440)
+    color: Couleurs.fond
+    onClosed: fermer()
+    Shortcut { sequence: "Escape"; onActivated: fen.fermer() }
+    Component.onCompleted: { CloudEtat.panneauOuvert = true; CloudEtat.relire(); CloudEtat.demander({ op: "transferts" }) }
+    Component.onDestruction: CloudEtat.panneauOuvert = false
