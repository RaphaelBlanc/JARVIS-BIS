@@ -0,0 +1,10 @@
+#!/usr/bin/env python3
+"""Cloud JARVIS distant — nc-cloud associer, fenetre, deposer FICHIER, ouvrir, etat."""
+from pathlib import Path
+import sys
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'share/nc-cloud'))
+from client import main
+
+if __name__ == '__main__':
+    raise SystemExit(main())
