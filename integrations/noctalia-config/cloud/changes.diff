+        anchors.fill: parent; anchors.margins: 24
+        contentWidth: width; contentHeight: contenu.height
+        clip: true
+        Column {
+            id: contenu
+            width: parent.width; spacing: 14
+            Texte { text: "Cloud JARVIS"; font.pixelSize: 24; font.bold: true }
+            Texte {
+                width: parent.width; wrapMode: Text.Wrap
+                text: Reglages.t("Stockage distant • accès fichiers en lecture seule • envois depuis cette fenêtre", "Remote storage • read-only Files access • uploads from this window")
+            }
+            Flow {
+                width: parent.width
+                spacing: 8
+                JarvisBouton { texte: Reglages.t("Actualiser", "Refresh"); enabled: !CloudEtat.occupe; onClic: { CloudEtat.relire(); if (CloudEtat.enLigne) CloudEtat.lister(CloudEtat.dossier.id) } }
+                JarvisBouton { texte: Reglages.t("Associer ce PC", "Associate this PC"); enabled: !CloudEtat.occupe; onClic: CloudEtat.demander({ op: "associer" }) }
+                JarvisBouton { texte: Reglages.t("Ouvrir dans Fichiers", "Open in Files"); enabled: CloudEtat.enLigne && !CloudEtat.occupe; onClic: CloudEtat.demander({ op: "ouvrir" }) }
+            }
+            Texte { width: parent.width; wrapMode: Text.Wrap; visible: text !== ""; text: CloudEtat.message; color: Couleurs.accent }
+            JarvisBouton { visible: !CloudEtat.active; texte: Reglages.t("Afficher le cloud dans la barre", "Show cloud in the bar"); onClic: CloudEtat.afficherDansBarre() }
+            Texte { visible: CloudEtat.occupe; text: Reglages.t("Vérification / préparation…", "Checking / preparing…") }
+            Row {
+                spacing: 8
+                JarvisBouton { texte: "↑"; enabled: CloudEtat.chemin.length > 0 && !CloudEtat.occupe; onClic: CloudEtat.remonter() }
+                Texte { text: "/" + CloudEtat.chemin.map(p => p.name || "").filter(p => p).concat([CloudEtat.dossier.name || ""]).filter(p => p).join("/"); width: Math.max(0, contenu.width - 58); elide: Text.ElideMiddle }
+            }
+            Repeater {
+                model: CloudEtat.dossiers
+                delegate: Rectangle {
+                    required property var modelData
+                    width: contenu.width; height: 36; radius: 8; color: Couleurs.gris2
+                    Texte { anchors.left: parent.left; anchors.leftMargin: 12; anchors.verticalCenter: parent.verticalCenter; width: parent.width - 24; elide: Text.ElideMiddle; text: (modelData.kind === "directory" ? "▸  " : "    ") + modelData.name }
+                    MouseArea { anchors.fill: parent; enabled: modelData.kind === "directory" && !CloudEtat.occupe; onClicked: CloudEtat.entrer(modelData) }
+                }
+            }
+            JarvisBouton { visible: CloudEtat.suite !== ""; texte: Reglages.t("Afficher la suite", "Load more"); onClic: CloudEtat.lister(CloudEtat.dossier.id, CloudEtat.suite) }
+            Row {
+                spacing: 8
+                TextField { id: nouveau; width: 260; placeholderText: Reglages.t("Nom du nouveau dossier", "New folder name") }
+                JarvisBouton {
+                    texte: Reglages.t("Créer", "Create"); enabled: CloudEtat.enLigne && !CloudEtat.occupe && nouveau.text.trim() !== ""
+                    onClic: { CloudEtat.demander({ op: "dossier", parent_id: CloudEtat.dossier.id, parent_revision: CloudEtat.dossier.revision, name: nouveau.text }); nouveau.text = "" }
+                }
+            }
+            Rectangle {
+                width: parent.width; height: 92; radius: 12
+                color: depot.containsDrag ? Couleurs.accent : Couleurs.gris2
+                Texte {
+                    anchors.fill: parent; anchors.margins: 12; wrapMode: Text.Wrap; verticalAlignment: Text.AlignVCenter
+                    text: CloudEtat.fichiers.length ? CloudEtat.fichiers.length + Reglages.t(" fichier(s) prêt(s). Choisis un dossier puis « Envoyer ici ».", " file(s) ready. Choose a folder, then “Upload here”.")
+                                                   : Reglages.t("Dépose ici jusqu’à 8 fichiers locaux. Ils seront copiés après ton choix de destination.", "Drop up to 8 local files here. They will be copied after you choose the destination.")
+                }
+                DropArea {
+                    id: depot; anchors.fill: parent
+                    onEntered: drag => { if (!drag.hasUrls) drag.accepted = false }
+                    onDropped: drop => {
+                        if (!drop.hasUrls) return
+                        var urls = []; for (let i = 0; i < drop.urls.length; ++i) urls.push(String(drop.urls[i]))
+                        CloudEtat.deposer(urls); drop.accept(Qt.CopyAction)
+                    }
+                }
+            }
+            JarvisBouton { texte: Reglages.t("Envoyer ici", "Upload here"); primaire: true; enabled: CloudEtat.enLigne && CloudEtat.fichiers.length > 0 && !CloudEtat.occupe; onClic: CloudEtat.envoyer() }
+            Texte { text: Reglages.t("Transferts", "Transfers"); font.pixelSize: 18 }
+            JarvisBouton { texte: Reglages.t("Actualiser les transferts", "Refresh transfers"); onClic: CloudEtat.demander({ op: "transferts" }) }
+            Repeater {
+                model: CloudEtat.transferts
+                delegate: Column {
+                    required property var modelData
+                    width: contenu.width; spacing: 5
+                    Texte { width: parent.width; elide: Text.ElideMiddle; text: modelData.name + " — " + CloudEtat.etatTexte(modelData.state) + " (" + (modelData.state === "committed" ? 100 : Math.round(100 * (modelData.sent || 0) / Math.max(1, modelData.size || 0))) + " %)" }
+                    Texte { width: parent.width; wrapMode: Text.Wrap; visible: text !== ""; text: modelData.message || "" }
+                    Texte {
+                        width: parent.width; wrapMode: Text.Wrap
+                        visible: modelData.state === "conflict" && modelData.current !== null
+                        text: modelData.current ? Reglages.t("Version distante : ", "Remote version: ") + new Date(modelData.current.modified * 1000).toLocaleString(Qt.locale()) + " · " + modelData.current.size + Reglages.t(" octets", " bytes") : ""
+                    }
+                    Row {
+                        spacing: 8
+                        JarvisBouton { visible: modelData.state === "interrupted"; texte: Reglages.t("Reprendre / vérifier", "Resume / verify"); enabled: CloudEtat.enLigne; onClic: CloudEtat.demander({ op: "reprise", id: modelData.id }) }
+                        JarvisBouton { visible: modelData.state === "conflict"; texte: Reglages.t("Conserver les deux", "Keep both"); enabled: CloudEtat.enLigne; onClic: CloudEtat.demander({ op: "resoudre", id: modelData.id, policy: "keep_both" }) }
+                        JarvisBouton { visible: modelData.state === "conflict" && modelData.current && modelData.current.kind === "file"; texte: Reglages.t("Remplacer", "Replace"); enabled: CloudEtat.enLigne; onClic: CloudEtat.demander({ op: "resoudre", id: modelData.id, policy: "replace" }) }
+                        JarvisBouton { visible: ["committed", "cancelled", "expired"].indexOf(modelData.state) < 0; texte: Reglages.t("Annuler", "Cancel"); enabled: CloudEtat.enLigne; onClic: CloudEtat.demander({ op: "annuler", id: modelData.id }) }
+                    }
+                }
+            }
+        }
+    }
+}
diff --git a/home/.config/quickshell/nc-ile/CloudDepot.qml b/home/.config/quickshell/nc-ile/CloudDepot.qml
new file mode 100644
index 0000000..c004a26
--- /dev/null
+++ b/home/.config/quickshell/nc-ile/CloudDepot.qml
@@ -0,0 +1,38 @@
+// Dedicated Wayland surface: hidden means no surface and no input region.
+import QtQuick
+import Quickshell
+import Quickshell.Wayland
+
+PanelWindow {
+    id: depot
+    required property var modelData
+    screen: modelData
+    anchors.top: true
+    anchors.left: true
+    margins.left: Math.max(0, Math.round((modelData.width - 36) / 2 + Number(Reglages.val("CLOUD_BARRE_DECALAGE", "100"))))
+    implicitWidth: 36; implicitHeight: Gabarit.barre
+    exclusionMode: ExclusionMode.Ignore
+    color: "transparent"
+    WlrLayershell.layer: WlrLayer.Overlay
+    WlrLayershell.namespace: "nc-cloud"
+    Rectangle {
+        anchors.centerIn: parent
+        width: 32; height: 28; radius: 14
+        color: zone.containsDrag ? Couleurs.accent : Couleurs.gris2
+        opacity: CloudEtat.enLigne ? 1 : 0.5
+        Ico { anchors.centerIn: parent; nom: "cloud"; taille: 20; color: Couleurs.texte }
+        MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: { CloudEtat.relire(); CloudEtat.ouvrirPanneau() } }
+    }
+    DropArea {
+        id: zone
+        anchors.fill: parent
+        onEntered: drag => { if (!drag.hasUrls) drag.accepted = false }
+        onDropped: drop => {
+            if (!drop.hasUrls) return
+            var urls = []
+            for (let i = 0; i < drop.urls.length; ++i) urls.push(String(drop.urls[i]))
+            CloudEtat.deposer(urls)
+            drop.accept(Qt.CopyAction)
+        }
+    }
+}
diff --git a/home/.config/quickshell/nc-ile/CloudEtat.qml b/home/.config/quickshell/nc-ile/CloudEtat.qml
new file mode 100644
index 0000000..45cfd8e
--- /dev/null
+++ b/home/.config/quickshell/nc-ile/CloudEtat.qml
@@ -0,0 +1,145 @@
+pragma Singleton
+import QtQuick
+import Quickshell
+import Quickshell.Io
+
+Singleton {
+    id: cloud
+    signal ouvrirPanneau()
+    readonly property string bin: Quickshell.env("HOME") + "/.local/bin/nc-cloud"
+    readonly property bool active: Reglages.val("CLOUD_JARVIS", "non") === "oui"
+    property bool visible: false
+    property bool enLigne: false
+    property bool attenteReponse: false
+    readonly property bool occupe: attenteReponse || commande.running
+    property bool panneauOuvert: false
+    property string message: ""
+    property var statut: ({})
+    property var dossier: ({ id: "root", revision: "", name: "Cloud JARVIS" })
+    property var dossiers: []
+    property var chemin: []
+    property var fichiers: []
+    property var transferts: []
+    property string suite: ""
+    property var attente: []
+    property var courant: ({})
+
+    function demander(body) {
+        attente = attente.concat([body])
+        executer()
+    }
+    function executer() {
+        if (attenteReponse || commande.running || attente.length === 0) return
+        courant = attente[0]; attente = attente.slice(1)
+        attenteReponse = true
+        commande.stdinEnabled = true
+        commande.running = true
+    }
+    function relire() { demander({ op: "etat" }) }
+    function etatTexte(state) {
+        var noms = { preparing: ["Préparation", "Preparing"], ready: ["Prêt", "Ready"], uploading: ["Envoi", "Uploading"],
+                     verifying: ["Vérification", "Verifying"], committed: ["Enregistré", "Saved"], interrupted: ["Interrompu", "Interrupted"],
+                     conflict: ["Conflit", "Conflict"], cancelled: ["Annulé", "Cancelled"], expired: ["Expiré", "Expired"] }
+        var nom = noms[state] || [state, state]
+        return Reglages.t(nom[0], nom[1])
+    }
+    function afficherDansBarre() { reglage.running = true }
+    function lister(id, cursor) { demander({ op: "lister", parent_id: id || "root", cursor: cursor || "" }) }
+    function entrer(entry) {
+        chemin = chemin.concat([dossier]); lister(entry.id)
+    }
+    function remonter() {
+        if (chemin.length === 0) return
+        var parent = chemin[chemin.length - 1]
+        chemin = chemin.slice(0, -1); lister(parent.id)
+    }
+    function deposer(urls) {
+        message = ""
+        if (!enLigne) {
+            message = Reglages.t("Cloud hors ligne. Aucun fichier envoyé. Réessaie après reconnexion.", "Cloud offline. No file uploaded. Try again after reconnecting.")
+        } else if (urls.length > 8) {
+            message = Reglages.t("Dépose au plus 8 fichiers à la fois.", "Drop at most 8 files at once.")
+        } else {
+            fichiers = urls
+        }
+        ouvrirPanneau()
+    }
+    function envoyer() {
+        if (!enLigne || !fichiers.length) return
+        demander({ op: "envoyer", files: fichiers, parent_id: dossier.id, parent_revision: dossier.revision })
+        fichiers = []
+    }
+    function reponse(result) {
+        if (courant.op === "etat" || courant.op === "associer") {
+            if (result.server_id && statut.server_id !== result.server_id) {
+                chemin = []; dossiers = []; fichiers = []
+                dossier = { id: "root", revision: "", name: "Cloud JARVIS" }
+            }
+            statut = result
+            enLigne = result.state === "ready"
+            visible = active && result.enabled !== false && (result.configured === true || enLigne)
+            if (enLigne) {
+                message = ""
+                if (!dossier.revision) lister("root")
+            } else {
+                fichiers = []; dossiers = []; chemin = []
+                dossier = { id: "root", revision: "", name: "Cloud JARVIS" }
+                message = result.message || Reglages.t("Cloud indisponible", "Cloud unavailable")
+            }
+        } else if (courant.op === "lister" && result.entries) {
+            dossier = result.parent
+            dossiers = courant.cursor ? dossiers.concat(result.entries) : result.entries
+            suite = result.next_cursor || ""
+        } else if (courant.op === "transferts") {
+            transferts = result.transfers || []
+        } else if (courant.op === "dossier") {
+            if (result.entry) lister(dossier.id)
+        } else if (courant.op === "envoyer") {
+            var errors = (result.results || []).filter(r => !r.ok)
+            message = errors.map(r => r.message).join("\n")
+            demander({ op: "transferts" })
+        }
+        if (result.ok === false || result.error) {
+            message = result.message || result.error || Reglages.t("Erreur cloud", "Cloud error")
+            if (["cloud_unavailable", "cloud_disabled", "device_revoked", "server_changed"].indexOf(result.error) >= 0) enLigne = false
+        }
+    }
+    Process {
+        id: commande
+        command: [cloud.bin, "requete"]
+        stdinEnabled: true
+        onStarted: { write(JSON.stringify(cloud.courant)); stdinEnabled = false }
+        stdout: StdioCollector {
+            onStreamFinished: {
+                try { cloud.reponse(JSON.parse(text)) }
+                catch (e) { cloud.message = Reglages.t("Réponse cloud illisible", "Invalid cloud response") }
+            }
+        }
+        onExited: Qt.callLater(() => { cloud.attenteReponse = false; cloud.executer() })
+    }
+    Process {
+        id: reglage
+        command: [Quickshell.env("HOME") + "/.local/bin/nc-reglages", "set", "CLOUD_JARVIS", "oui"]
+    }
+    Process {
+        command: ["nmcli", "monitor"]
+        running: cloud.active && cloud.visible && Etat.ecranVu
+        stdout: SplitParser { onRead: reseau.restart() }
+    }
+    Timer { id: reseau; interval: 600; onTriggered: cloud.relire() }
+    // No network loop: configured users refresh on wake, connection changes, or an explicit action.
+    FileView {
+        path: Quickshell.env("HOME") + "/.config/nc/assistant.conf"
+        watchChanges: cloud.active
+        onFileChanged: { reload(); if (cloud.active) cloud.relire() }
+    }
+    Connections { target: Etat; function onEcranVuChanged() { if (cloud.active && Etat.ecranVu) cloud.relire() } }
+    onActiveChanged: { if (active) relire(); else { visible = false; enLigne = false; fichiers = [] } }
+    Component.onCompleted: if (active) relire()
+    Timer {
+        interval: 1000; repeat: true
+        running: cloud.panneauOuvert && Etat.ecranVu && !cloud.occupe
+                 && cloud.transferts.some(t => ["ready", "preparing", "uploading", "verifying"].indexOf(t.state) >= 0)
+        onTriggered: cloud.demander({ op: "transferts" })
+    }
+}
