[Unit]
Description=Assistant Personnel — Home Runner (FastAPI + agy bridge)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
# Remplacez par votre utilisateur Linux
User=pi
Group=pi
WorkingDirectory=/home/pi/assistant-unifie/home-runner
EnvironmentFile=/home/pi/assistant-unifie/home-runner/.env
ExecStart=/home/pi/assistant-unifie/home-runner/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8080 --log-level info

Restart=always
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=assistant-runner

[Install]
WantedBy=multi-user.target
