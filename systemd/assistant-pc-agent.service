[Unit]
Description=Assistant Personnel — Agent Local PC (Hardware Relay)
After=network.target graphical-session.target
Wants=network.target

[Service]
Type=simple
WorkingDirectory=%h/assistant-perso
EnvironmentFile=%h/assistant-perso/.env
ExecStart=/usr/bin/python3 %h/assistant-perso/pc-agent/agent.py

Restart=always
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=assistant-pc-agent

[Install]
WantedBy=default.target
