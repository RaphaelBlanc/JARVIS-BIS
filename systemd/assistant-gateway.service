[Unit]
Description=Assistant Personnel — Gateway (Discord + Telegram Bots)
After=network.target assistant-runner.service
Wants=network.target

[Service]
Type=simple
# Remplacez par votre utilisateur Linux
User=%I
WorkingDirectory=%h/assistant-perso/render-gateway
EnvironmentFile=%h/assistant-perso/render-gateway/.env
ExecStart=%h/assistant-perso/render-gateway/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --log-level info

Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=assistant-gateway

[Install]
WantedBy=default.target
