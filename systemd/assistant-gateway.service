[Unit]
Description=Assistant Personnel — Gateway (Discord + Telegram Bots)
After=network.target network-online.target assistant-runner.service
Wants=network-online.target assistant-runner.service

[Service]
Type=simple
# Remplacez par votre utilisateur Linux
User=pi
Group=pi
WorkingDirectory=/home/pi/assistant-unifie/gateway
Environment=PYTHONPATH=/home/pi/assistant-unifie
EnvironmentFile=/home/pi/assistant-unifie/gateway/.env
ExecStart=/home/pi/assistant-unifie/gateway/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --log-level info

Restart=always
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=assistant-gateway

[Install]
WantedBy=multi-user.target
