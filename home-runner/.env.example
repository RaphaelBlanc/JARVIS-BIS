# Clé secrète partagée avec render-gateway (générer avec: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_me_generate_a_strong_key

# Port d'écoute du home-runner
PORT=8080

# Timeout AGY en secondes
AGY_TIMEOUT=120

# Worker agy persistant (stream-json) : 1 = activé, 0 = ancien mode one-shot
AGY_PERSISTENT=1

# Durée d'inactivité avant arrêt automatique du worker (secondes)
AGY_WORKER_IDLE_TIMEOUT=900

# Délai maximal pour le démarrage du worker (secondes)
AGY_STARTUP_TIMEOUT=30

# Sandbox terminal d'agy (1 = activé, 0 = désactivé)
AGY_SANDBOX=1

# Limites d'entrée
MAX_PROMPT_CHARS=20000
MAX_IMAGE_MB=10

# Mémoire durable injectée (profil + N souvenirs récents, budget en caractères)
MEMORY_PROMPT_MAX_CHARS=1500
MEMORY_PROMPT_MAX_FACTS=10

# Compaction automatique après N tours de conversation (0 = désactivée)
AUTO_COMPACT_TURNS=20
