# URL publique du home-runner (via Cloudflare Tunnel)
HOME_SERVER_URL=https://ton-tunnel.trycloudflare.com

# Clé secrète partagée avec le home-runner (même valeur)
SECRET_KEY=change_me_generate_a_strong_key

# Longueur maximale d'une réponse avant troncature (0 = pas de limite)
MAX_RESPONSE_LENGTH=50000

# Bot Telegram (obtenable via @BotFather sur Telegram)
TELEGRAM_TOKEN=123456:ABC-DEF...
# URL publique de ce service Render (pour le webhook)
TELEGRAM_WEBHOOK_URL=https://mon-assistant.onrender.com
# Secret du webhook Telegram (laisser vide pour le dériver de SECRET_KEY)
TELEGRAM_WEBHOOK_SECRET=

# Bot Discord (depuis discord.com/developers)
DISCORD_TOKEN=MTI...
DISCORD_GUILD_ID=  # Optionnel: ID de ton serveur Discord (pour les slash commands en dev)

# Sécurité: liste d'IDs utilisateurs autorisés.
# Par défaut (fail-closed), une liste vide refuse tout le monde.
TELEGRAM_ALLOWED_USER_IDS=  # ex: 123456789,987654321
DISCORD_ALLOWED_USER_IDS=   # ex: 123456789,987654321
# Mettre 1 pour autoriser tout le monde SANS whitelist (non recommandé).
ALLOW_ALL_USERS=0
